  "data_dictionary": [
    {
      "entity": "Customer",
      "table": "customers",
      "primary_key": "customer_id",
      "description": "A person enrolled in the Morrow & Finch loyalty programme. No real personal data is used.",
      "fields": [
        [
          "customer_id",
          "string",
          "yes",
          "C-000001",
          "unique",
          "Regex ^C-\\d{6}$; immutable"
        ],
        [
          "first_name",
          "string",
          "yes",
          "Aisha",
          "-",
          "2–40 chars; synthetic name"
        ],
        [
          "last_name",
          "string",
          "yes",
          "Patel",
          "-",
          "2–40 chars; synthetic name"
        ],
        [
          "email",
          "string",
          "yes",
          "aisha.patel.00001@example.test",
          "unique",
          "RFC 5322 basic pattern; .test domain only"
        ],
        [
          "region",
          "enum",
          "yes",
          "Greater London",
          "-",
          "One of the nine configured regions"
        ],
        [
          "city",
          "string",
          "yes",
          "London",
          "-",
          "Must match region lookup"
        ],
        [
          "acquisition_channel",
          "enum",
          "yes",
          "online",
          "-",
          "online | store | app | referral"
        ],
        [
          "marketing_consent",
          "boolean",
          "yes",
          "true",
          "-",
          "True or false; independent of programme state"
        ],
        [
          "status",
          "enum",
          "yes",
          "active",
          "-",
          "active | inactive | deactivated"
        ],
        [
          "joined_at",
          "datetime",
          "yes",
          "2023-04-18T10:22:00Z",
          "-",
          "Before first account activity"
        ],
        [
          "updated_at",
          "datetime",
          "yes",
          "2026-10-31T18:00:00Z",
          "-",
          "At or after joined_at"
        ]
      ]
    },
    {
      "entity": "LoyaltyAccount",
      "table": "loyalty_accounts",
      "primary_key": "account_id",
      "description": "One programme account per customer; the materialised balance is derived from the ledger.",
      "fields": [
        [
          "account_id",
          "string",
          "yes",
          "LOY-C-000001",
          "unique",
          "Regex ^LOY-C-\\d{6}$; 1:1 with customer_id"
        ],
        [
          "customer_id",
          "string FK",
          "yes",
          "C-000001",
          "unique",
          "References customers.customer_id"
        ],
        [
          "tier_id",
          "string FK",
          "yes",
          "TIER-02",
          "-",
          "References tiers.tier_id"
        ],
        [
          "opened_at",
          "datetime",
          "yes",
          "2023-04-18T10:22:00Z",
          "-",
          "Must equal or follow customer.joined_at"
        ],
        [
          "status",
          "enum",
          "yes",
          "active",
          "-",
          "active | suspended | closed"
        ],
        [
          "available_points",
          "integer",
          "yes",
          "1840",
          "-",
          ">= 0 in valid rows; equals ledger sum unless labelled mismatch"
        ],
        [
          "pending_points",
          "integer",
          "yes",
          "0",
          "-",
          ">= 0; pending earns are excluded from available balance"
        ],
        [
          "lifetime_earned_points",
          "integer",
          "yes",
          "12680",
          "-",
          "Sum of positive accrual, bonus and adjustment rows"
        ],
        [
          "qualifying_spend_cents",
          "integer",
          "yes",
          "54820",
          "GBP cents",
          "Trailing 365-day net eligible spend after returns"
        ],
        [
          "tier_reviewed_at",
          "datetime",
          "yes",
          "2026-10-01T00:00:00Z",
          "-",
          "Effective date of current tier"
        ],
        [
          "last_activity_at",
          "datetime",
          "no",
          "2026-10-30T14:16:00Z",
          "-",
          "Maximum posted_at across ledger rows"
        ],
        [
          "updated_at",
          "datetime",
          "yes",
          "2026-11-01T09:00:00Z",
          "-",
          "Snapshot materialisation time"
        ]
      ]
    },
    {
      "entity": "Tier",
      "table": "tiers",
      "primary_key": "tier_id",
      "description": "Configured membership tier and its qualifying-spend threshold.",
      "fields": [
        [
          "tier_id",
          "string",
          "yes",
          "TIER-02",
          "unique",
          "Regex ^TIER-\\d{2}$"
        ],
        [
          "tier_name",
          "string",
          "yes",
          "Silver",
          "unique",
          "Member | Silver | Gold | Platinum"
        ],
        [
          "rank",
          "integer",
          "yes",
          "2",
          "ordinal",
          "1–4; strictly increasing"
        ],
        [
          "qualify_spend_cents",
          "integer",
          "yes",
          "10000",
          "GBP cents",
          ">= 0; monotonic by rank"
        ],
        [
          "valid_from",
          "date",
          "yes",
          "2024-01-01",
          "-",
          "Effective date"
        ],
        [
          "valid_to",
          "date",
          "no",
          "",
          "-",
          "Null means open-ended; >= valid_from"
        ],
        [
          "status",
          "enum",
          "yes",
          "active",
          "-",
          "active | retired"
        ]
      ]
    },
    {
      "entity": "Rule",
      "table": "rules",
      "primary_key": "rule_id",
      "description": "Versioned earning, redemption, expiry, tier and bonus policy with effective dates.",
      "fields": [
        [
          "rule_id",
          "string",
          "yes",
          "RULE-EARN-2024-V1",
          "unique",
          "Immutable; version suffix required"
        ],
        [
          "rule_code",
          "enum",
          "yes",
          "EARN_RATE",
          "-",
          "EARN_RATE | REDEMPTION | EXPIRY | TIER_REVIEW | BONUS"
        ],
        [
          "version",
          "integer",
          "yes",
          "1",
          "-",
          ">= 1; unique per rule_code"
        ],
        [
          "name",
          "string",
          "yes",
          "Earn rate, 2024 schedule",
          "-",
          "Human-readable policy name"
        ],
        [
          "effective_from",
          "datetime",
          "yes",
          "2024-01-01T00:00:00Z",
          "-",
          "Start of validity"
        ],
        [
          "effective_to",
          "datetime",
          "no",
          "2025-12-31T23:59:59Z",
          "-",
          "Null means current; later than effective_from"
        ],
        [
          "parameters",
          "json",
          "yes",
          "{\"points_per_gbp\":10}",
          "-",
          "Validated key/value policy object"
        ],
        [
          "status",
          "enum",
          "yes",
          "active",
          "-",
          "draft | active | superseded"
        ]
      ]
    },
    {
      "entity": "Order",
      "table": "orders",
      "primary_key": "order_id",
      "description": "A completed purchase used as the source for accrual and return events.",
      "fields": [
        [
          "order_id",
          "string",
          "yes",
          "ORD-2026-000001",
          "unique",
          "Regex ^ORD-\\d{4}-\\d{6}$; year matches order_ts"
        ],
        [
          "customer_id",
          "string FK",
          "yes",
          "C-000001",
          "-",
          "References customers.customer_id"
        ],
        [
          "account_id",
          "string FK",
          "yes",
          "LOY-C-000001",
          "-",
          "References loyalty_accounts.account_id"
        ],
        [
          "order_ts",
          "datetime",
          "yes",
          "2026-10-17T14:32:00Z",
          "-",
          "Within dataset window; after account open"
        ],
        [
          "channel",
          "enum",
          "yes",
          "online",
          "-",
          "online | store | app"
        ],
        [
          "store_id",
          "string FK",
          "no",
          "S-11",
          "-",
          "Required for store orders; null otherwise"
        ],
        [
          "gross_cents",
          "integer",
          "yes",
          "12800",
          "GBP cents",
          ">= 0; equals sum of line gross"
        ],
        [
          "discount_cents",
          "integer",
          "yes",
          "1280",
          "GBP cents",
          ">= 0; <= gross"
        ],
        [
          "tax_cents",
          "integer",
          "yes",
          "2304",
          "GBP cents",
          "= floor((gross-discount) × 20%)"
        ],
        [
          "shipping_cents",
          "integer",
          "yes",
          "0",
          "GBP cents",
          "0 | 499 | 699"
        ],
        [
          "net_eligible_cents",
          "integer",
          "yes",
          "11520",
          "GBP cents",
          "Sum of eligible line net; excludes gift cards, tax and shipping"
        ],
        [
          "refund_cents",
          "integer",
          "yes",
          "0",
          "GBP cents",
          "0–(gross-discount); ties to returned_qty"
        ],
        [
          "status",
          "enum",
          "yes",
          "completed",
          "-",
          "completed | partially_returned | returned | voided"
        ],
        [
          "returned_at",
          "datetime",
          "no",
          "",
          "-",
          "Required iff status is partially_returned or returned; after order_ts"
        ]
      ]
    },
    {
      "entity": "OrderLine",
      "table": "order_lines",
      "primary_key": "order_line_id",
      "description": "Product-level purchase line. Points accrue per eligible line, giving source-level traceability.",
      "fields": [
        [
          "order_line_id",
          "string",
          "yes",
          "OL-2026-000001",
          "unique",
          "Regex ^OL-\\d{4}-\\d{6}$"
        ],
        [
          "order_id",
          "string FK",
          "yes",
          "ORD-2026-000001",
          "-",
          "References orders.order_id"
        ],
        [
          "sku",
          "string",
          "yes",
          "APP-1042",
          "unique per category",
          "Synthetic SKU; no real catalogue data"
        ],
        [
          "product_name",
          "string",
          "yes",
          "Ribbed merino crew",
          "-",
          "Synthetic product label"
        ],
        [
          "category",
          "enum",
          "yes",
          "apparel",
          "-",
          "apparel | footwear | home | beauty | accessories | gift_card"
        ],
        [
          "quantity",
          "integer",
          "yes",
          "1",
          "units",
          "1–4"
        ],
        [
          "unit_price_cents",
          "integer",
          "yes",
          "6500",
          "GBP cents",
          "> 0"
        ],
        [
          "discount_cents",
          "integer",
          "yes",
          "650",
          "GBP cents",
          "0 <= discount <= quantity × unit_price"
        ],
        [
          "line_net_cents",
          "integer",
          "yes",
          "5850",
          "GBP cents",
          "quantity × unit_price - discount"
        ],
        [
          "eligible_for_points",
          "boolean",
          "yes",
          "true",
          "-",
          "False for gift_card category"
        ],
        [
          "returned_qty",
          "integer",
          "yes",
          "0",
          "units",
          "0–quantity; zero if not returned"
        ],
        [
          "returned_amount_cents",
          "integer",
          "yes",
          "0",
          "GBP cents",
          "0 <= returned_amount <= line_net"
        ]
      ]
